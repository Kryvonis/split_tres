#include <behaviors.dtsi>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEFAULT 0
#define SYSTEM  1
#define GAME    2
#define FUNCTION 3


&lt {
    tapping-term-ms = <200>;
    flavor = "hold-preferred";
};

/ {

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
            bindings = <
                    &kp ESC    &kp N1     &kp N2     &kp N3     &kp N4     &kp N5                 &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp BSLH
                    &kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T                  &kp Y      &kp U      &kp I      &kp O      &kp P      &kp GRAVE
                    &kp CAPS   &kp A      &kp S      &kp D      &kp F      &kp G                  &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
                    &kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B                  &kp M      &kp COMMA  &kp DOT    &kp LT     &kp GT     &kp SLASH
                                                     &bootloader      &sys_reset  &lt SYSTEM RET        &sys_reset &sys_reset &kp LGUI
                                                     &studio_unlock   &kp BACKSPACE &studio_unlock             &kp ENTER   &kp EQUAL  &kp SPACE
            >;
        };
        system_layer {
            display-name = "system";
            bindings = <
                    &kp ESC    &kp N1     &kp N2     &kp N3     &kp N4     &kp N5                 &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp BSLH
                    &kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T                  &kp Y      &kp U      &kp I      &kp O      &kp P      &kp GRAVE
                    &kp CAPS   &kp A      &kp S      &kp D      &kp F      &kp G                  &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
                    &kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B                  &kp M      &kp COMMA  &kp DOT    &kp LT     &kp GT     &kp SLASH
                                                     &kp LGUI   &sys_reset &bootloader                     &bootloader &sys_reset &kp LGUI
                                                     &studio_unlock    &bt BT_SEL 0 &bt BT_CLR_ALL                &kp ENTER   &kp EQUAL  &kp SPACE
            >;
        };

        game_layer {
            display-name = "game";
            bindings = <
                    &kp ESC    &kp N1     &kp N2     &kp N3     &kp N4     &kp N5                 &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp BSLH
                    &kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T                  &kp Y      &kp U      &kp I      &kp O      &kp P      &kp GRAVE
                    &kp CAPS   &kp A      &kp S      &kp D      &kp F      &kp G                  &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
                    &kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B                  &kp M      &kp COMMA  &kp DOT    &kp LT     &kp GT     &kp SLASH
                                                     &kp LGUI   &sys_reset &bootloader                     &bootloader &sys_reset &kp LGUI
                                                     &studio_unlock    &bt BT_SEL 0 &bt BT_CLR_ALL                &kp ENTER   &kp EQUAL  &kp SPACE
            >;
        };

        function_layer {
            display-name = "function";
            bindings = <
                    &kp ESC    &kp N1     &kp N2     &kp N3     &kp N4     &kp N5                 &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp BSLH
                    &kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T                  &kp Y      &kp U      &kp I      &kp O      &kp P      &kp GRAVE
                    &kp CAPS   &kp A      &kp S      &kp D      &kp F      &kp G                  &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
                    &kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B                  &kp M      &kp COMMA  &kp DOT    &kp LT     &kp GT     &kp SLASH
                                                     &kp LGUI   &sys_reset &bootloader                     &bootloader &sys_reset &kp LGUI
                                                     &studio_unlock    &bt BT_SEL 0 &bt BT_CLR_ALL                &kp ENTER   &kp EQUAL  &kp SPACE
            >;
        };


    };
};
